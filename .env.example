# Firebase Client Configuration (Public VITE_ prefix)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_key

# AI Chatbot Configuration (Backend Secrets - NEVER prefix with VITE_)
GEMINI_API_KEY=your_gemini_api_key
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=gemini-embedding-001
CHAT_MAX_TOKENS=800
CHAT_RATE_LIMIT=15

# Email & SMS Backend Secrets
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password
OTP_SESSION_SECRET=replace_with_a_long_random_server_secret
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RESEND_API_KEY=your_resend_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWO_FACTOR_API_KEY=your_two_factor_backend_key
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
